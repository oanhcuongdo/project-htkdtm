# Sao chép thành .env rồi điền giá trị. KHÔNG commit tệp .env (đã có trong .gitignore).
# Chỉ tệp .env.example này được commit, và các khóa bí mật phải để TRỐNG.

# --- PostgreSQL ---
POSTGRES_DB=eduvision
POSTGRES_USER=eduvision
# Bắt buộc: tự đặt một mật khẩu cho máy của bạn
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- API FastAPI ---
API_PORT=8000
APP_ENV=dev
# Danh sách nguồn được phép gọi API (website), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Apache Superset (chỉ cần khi chạy: docker compose --profile bi up -d --build) ---
# Tạo giá trị ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=
SUPERSET_GUEST_TOKEN_SECRET=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com
# Mật khẩu của tài khoản PostgreSQL chỉ đọc superset_ro (script khởi tạo tự tạo tài khoản này)
SUPERSET_DB_PASSWORD=

# --- Tự động hóa n8n (chỉ cần khi chạy: docker compose --profile automation up -d --build) ---
# Tạo giá trị ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Khóa để n8n gọi bộ chạy ETL (từ 16 ký tự; bộ chạy từ chối khởi động nếu thiếu). Cũng nhập vào credential của n8n.
ETL_RUNNER_TOKEN=
# Khóa mã hóa thông tin đăng nhập trong n8n: đặt MỘT LẦN rồi giữ nguyên; đổi khóa là mất credentials đã lưu.
N8N_ENCRYPTION_KEY=
# Khóa cho webhook "Cập nhật dữ liệu" (website hoặc API gọi vào n8n bằng tiêu đề X-Webhook-Key). Phải khác ETL_RUNNER_TOKEN.
N8N_WEBHOOK_KEY=
N8N_PORT=5678
MAILPIT_UI_PORT=8025
# Giây chờ tối thiểu giữa hai lần chạy ETL qua bộ chạy (chống bấm liên tục)
ETL_RUNNER_MIN_INTERVAL=60
# Email cảnh báo: mặc định gửi vào hộp thư thử Mailpit (http://localhost:8025), KHÔNG ra Internet.
# Muốn gửi email thật, bỏ dấu # và điền SMTP của bạn (Gmail: dùng "mật khẩu ứng dụng", không dùng mật khẩu Gmail), rồi chạy lại setup_n8n.py.
# Địa chỉ nhận email cảnh báo và báo lỗi ETL (một địa chỉ). Để trống thì dùng địa chỉ thử trong workflow (chỉ tới Mailpit).
# ALERT_EMAIL_TO=
# Địa chỉ gửi; để trống thì dùng SMTP_USER khi đã cấu hình SMTP thật (Gmail yêu cầu trùng tài khoản đăng nhập)
# ALERT_EMAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=

# --- Dành cho các phần sau (chưa dùng) ---
# Khóa YouTube Data API, LLM cho chatbot... đặt trong .env của bạn, không ghi vào tệp này
YOUTUBE_API_KEY=
LLM_API_KEY=

# --- Đăng nhập JWT của API (Hoàng Anh, HA3) ---
# Tạo khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tài khoản demo cho hai vai trò Admin và Viewer: tự đặt mật khẩu mạnh, KHÔNG dùng mật khẩu đoán được.
AUTH_JWT_SECRET=
AUTH_TOKEN_MINUTES=60
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=
AUTH_VIEWER_USER=viewer
AUTH_VIEWER_PASSWORD=
