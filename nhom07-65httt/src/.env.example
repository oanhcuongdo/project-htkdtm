# Copy to nhom07-65httt/src/.env and replace every CHANGE_ME value.
# All services (Docker Compose, Backend, AI, Worker, Next.js) share this file.

# ==============================================================================
# 1. Docker Compose Local Infrastructure & Host Ports
# ==============================================================================
DB_USER=learning_hub
DB_PASSWORD=CHANGE_ME_database_password
DB_NAME=learning_hub
MINIO_ROOT_USER=CHANGE_ME_storage_user
MINIO_ROOT_PASSWORD=CHANGE_ME_storage_password

# Optional host port overrides (only needed if default ports are already in use)
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
# WEB_HOST_PORT=3000

# ==============================================================================
# 2. Core Security & Admin Seed
# ==============================================================================
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_characters
AI_KEY_ENCRYPTION_KEY=CHANGE_ME_generate_32_random_bytes_as_hex
INTERNAL_API_KEY=CHANGE_ME_generate_at_least_16_random_characters
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ==============================================================================
# 3. Application Mode & Service URLs
# ==============================================================================
DEBUG=true
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
# Optional comma-separated extra origins (e.g. Vercel frontend URL in production)
# CORS_ORIGINS=https://your-app.vercel.app

# ==============================================================================
# 4. Database, Redis & Vector Store (Qdrant)
# ==============================================================================
# Note: Docker Compose overrides hostnames (db, redis, qdrant) internally.
# For native runs or Cloud deploy (Neon, Upstash, Qdrant Cloud), set URLs below.
DATABASE_URL=postgresql+asyncpg://learning_hub:CHANGE_ME_database_password@localhost:5432/learning_hub
DB_SSL_MODE=disable
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=

# ==============================================================================
# 5. Object Storage (MinIO / Cloudflare R2)
# ==============================================================================
# For Cloudflare R2: MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com, MINIO_SECURE=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_storage_user
MINIO_SECRET_KEY=CHANGE_ME_storage_password
MINIO_BUCKET_NAME=learninghubs
MINIO_SECURE=false

# ==============================================================================
# 6. Optional External Integrations (OAuth, Payment, Email)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

VNPAY_MERCHANT_ID=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:3000/payment/return
ENABLE_MOCK_PAYMENT=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=noreply@learninghub.ai

# ==============================================================================
# 7. Frontend (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
INTERNAL_API_URL=http://localhost:8000
