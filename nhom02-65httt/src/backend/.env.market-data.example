# Redis/Celery
REDIS_URL=redis://localhost:6379/0

# Dataset snapshot
COMPETITOR_DATASET_PATH=../../datasets/competitor-prices-vnd.csv
NORMALIZED_DATASET_PATH=data/competitor_prices_normalized.csv

# PostgreSQL – chỉ điền sau khi thống nhất schema với thành viên Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_pricing

# Optional: API price-history endpoint đã được xác minh và được phép sử dụng
PRICE_HISTORY_API_URL=

# Optional: endpoint FastAPI do nhóm xây dựng để nhận batch Chrome CDP
CRAWLER_CDP_INGEST_URL=http://127.0.0.1:8000/api/v1/crawler/ingest-cdp
