# PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp_smart_pricing
POSTGRES_HOST_PORT=5432

# Backend API & Workers
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://erp:erp@postgres:5432/erp_smart_pricing
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Demo seed password only; replace in real environments (matches LoginPage demo hint)
SEED_DEFAULT_PASSWORD=demo1234

# Apache Superset
SUPERSET_SECRET_KEY=change-me-superset-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@erp.demo
