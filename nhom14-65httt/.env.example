# ============================================================
# Vị Việt – Biến môi trường mẫu
# Copy thành .env và điền giá trị thực trước khi chạy.
# KHÔNG commit file .env chứa giá trị thật.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=viviet
POSTGRES_USER=viviet
POSTGRES_PASSWORD=changeme
# DATABASE_URL=sqlite:///./viviet.db  # Tùy chọn cho demo local không có PostgreSQL

# --- Backend ---
SECRET_KEY=changeme-generate-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Google Maps (tùy chọn, bỏ trống nếu chưa có) ---
GOOGLE_MAPS_API_KEY=

# --- AI ---
RECOMMENDATION_ALGORITHM_VERSION=content_v1
