# --- CSDL PostgreSQL Data Warehouse ---
POSTGRES_DB=personal_finance_dw
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=SecurePassword123!
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
SECRET_KEY=supersecretkeyforfinanceapp2026

# --- Apache Superset ---
SUPERSET_SECRET_KEY=generate_a_random_32_byte_secret_key_here
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- Email Collector (IMAP / Gmail API) ---
IMAP_SERVER=imap.gmail.com
IMAP_EMAIL=your_email@gmail.com
IMAP_APP_PASSWORD=your_gmail_app_password

# --- Telegram Bot & OCR ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Google Gemini AI Chat Agent ---
GEMINI_API_KEY=your_gemini_api_key_here
